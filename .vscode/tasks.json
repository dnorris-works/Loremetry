{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web:dev-api",
      "type": "shell",
      "command": "cargo run -p loremetry-web",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DATA_DIR": "${workspaceFolder}/data",
          "STATIC_DIR": "${workspaceFolder}/ui/dist",
          "PORT": "8080"
        }
      },
      "problemMatcher": ["$rustc"],
      "isBackground": true
    },
    {
      "label": "web:dev-ui",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "web:build-ui",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "problemMatcher": []
    }
  ]
}
