{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug loremetry-web",
      "cargo": {
        "args": ["build", "-p", "loremetry-web"],
        "filter": {
          "name": "loremetry-web",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "DATA_DIR": "${workspaceFolder}/data",
        "STATIC_DIR": "${workspaceFolder}/ui/dist",
        "PORT": "8080"
      }
    }
  ]
}
